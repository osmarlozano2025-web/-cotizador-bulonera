node_modules/
dist/

# Credenciales: la contraseña de la base, el JWT y la clave de OpenAI.
# El repositorio es público, así que nada de esto se versiona.
.env
.env.*
!.env.example

# Claves del servidor y de FTP escritas en texto plano.
credenciales.txt
server-config.json

# Volcados de la base: tienen datos reales de los clientes (nombre, CUIT,
# teléfono). No van a un repositorio público.
respaldos/
docs/respaldos-db/
documentos-fuera-del-repo/

# Ruido del sistema y del editor
Thumbs.db
desktop.ini
.DS_Store

# El paquete armado para subir al servidor: se regenera con npm run deploy:paquete
dist-deploy/

# Planillas exportadas de Tango: traen los códigos de todos los clientes y
# artículos de la bulonera. No van a un repositorio público. La del backend
# (app/api-php/plantillas/tango-pedidos.xlsx) se sube igual con el deploy,
# que copia desde el disco; si falta, se exporta de nuevo desde Tango:
# Ventas → Pedidos → Apertura → Excel → Exportar → "Sin datos".
docs/tango/**/*.xlsx
app/api-php/plantillas/*.xlsx

# Contexto completo del proyecto: nombres, accesos y datos internos. No va a un repo público.
docs/CONTEXTO-PROYECTO.md

# Cuentas con usuario y contraseña (aunque sea hash): nunca al repo público.
app/server/data/personal.json
