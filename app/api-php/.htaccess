# Desde internet sólo se entra por index.php (el router de la API, al que llegan
# los pedidos /api/*). Todo lo demás de esta carpeta es código, datos o
# configuración y no se sirve nunca.
Options -Indexes

<FilesMatch "^(\.env.*|config\.php|migrate\.php|sync-tango\.php)$|\.(env|sql|md|xlsx|xls|json|txt|log|bak|dist|example|sh)$">
    Require all denied
</FilesMatch>
